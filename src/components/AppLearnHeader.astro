---
/**
 * AppLearnHeader — Microsoft Learn–style page header
 * Shows the official Microsoft product icon, app name, category badge, and description.
 *
 * Usage:
 *   import AppLearnHeader from '../../src/components/AppLearnHeader.astro';
 *   <AppLearnHeader app="word" />
 */

export interface Props {
  app: string;
}

const { app } = Astro.props;

/* ── catalogue ─────────────────────────────────────────────── */

interface AppMeta {
  name: string;
  category: string;
  categoryColor: string;
  iconBg: string;
  description: string;
}

const catalog: Record<string, AppMeta> = {
  /* ── Copilot in Apps ─────────────────────────────────── */
  word:       { name: 'Microsoft Word',       category: 'Copilot trong ứng dụng', categoryColor: '#185ABD', iconBg: '#185ABD', description: 'Soạn thảo, chỉnh sửa và tóm tắt tài liệu nhanh hơn.' },
  excel:      { name: 'Microsoft Excel',      category: 'Copilot trong ứng dụng', categoryColor: '#107C41', iconBg: '#107C41', description: 'Khám phá dữ liệu, tạo công thức và biểu đồ bằng ngôn ngữ thường ngày.' },
  powerpoint: { name: 'Microsoft PowerPoint', category: 'Copilot trong ứng dụng', categoryColor: '#C43E1C', iconBg: '#C43E1C', description: 'Tạo bài trình bày từ ý tưởng hoặc tài liệu có sẵn.' },
  outlook:    { name: 'Microsoft Outlook',    category: 'Copilot trong ứng dụng', categoryColor: '#0078D4', iconBg: '#0078D4', description: 'Xử lý hộp thư, tóm tắt chuỗi mail và soạn phản hồi.' },
  teams:      { name: 'Microsoft Teams',      category: 'Copilot trong ứng dụng', categoryColor: '#6264A7', iconBg: '#6264A7', description: 'Tóm tắt cuộc họp, cuộc trò chuyện và việc cần theo dõi.' },
  onenote:    { name: 'Microsoft OneNote',    category: 'Copilot trong ứng dụng', categoryColor: '#7719AA', iconBg: '#7719AA', description: 'Biến ghi chú rời rạc thành tóm tắt, kế hoạch và danh sách việc.' },
  forms:      { name: 'Microsoft Forms',      category: 'Copilot trong ứng dụng', categoryColor: '#077568', iconBg: '#077568', description: 'Tạo khảo sát và biểu mẫu từ một mô tả ngắn gọn.' },
  whiteboard: { name: 'Microsoft Whiteboard', category: 'Copilot trong ứng dụng', categoryColor: '#2B88D8', iconBg: '#2B88D8', description: 'Khởi động brainstorm, nhóm ý tưởng và tóm tắt kết quả.' },
  onedrive:   { name: 'Microsoft OneDrive',   category: 'Copilot trong ứng dụng', categoryColor: '#0078D4', iconBg: '#0078D4', description: 'Tóm tắt, so sánh và hỏi đáp về file không cần mở.' },
  planner:    { name: 'Microsoft Planner',    category: 'Copilot trong ứng dụng', categoryColor: '#31752F', iconBg: '#31752F', description: 'Lập kế hoạch, tạo task và theo dõi tiến độ dự án.' },
  /* ── Agents ──────────────────────────────────────────── */
  researcher:     { name: 'Researcher',     category: 'Agent', categoryColor: '#6B4FBB', iconBg: '#6B4FBB', description: 'Nghiên cứu chuyên sâu, tổng hợp nhiều nguồn và báo cáo có trích dẫn.' },
  analyst:        { name: 'Analyst',         category: 'Agent', categoryColor: '#0E7A0D', iconBg: '#0E7A0D', description: 'Phân tích dữ liệu có cấu trúc, chạy thống kê và tạo biểu đồ.' },
  cowork:         { name: 'Cowork',          category: 'Agent', categoryColor: '#0078D4', iconBg: '#0078D4', description: 'Thực thi tác vụ nhiều bước xuyên Microsoft 365.' },
  'agent-builder':{ name: 'Agent Builder',   category: 'Agent', categoryColor: '#8661C5', iconBg: '#8661C5', description: 'Tự tạo agent tùy chỉnh bằng ngôn ngữ tự nhiên.' },
  'copilot-chat': { name: 'Copilot Chat',    category: 'Copilot', categoryColor: '#6264A7', iconBg: '#6264A7', description: 'Trợ lý hội thoại để tổng hợp, soạn thảo và chuẩn bị bước tiếp theo.' },
};

const meta = catalog[app] ?? catalog['copilot-chat'];
---

<div class="learn-header" style={`--lh-accent: ${meta.categoryColor}; --lh-icon-bg: ${meta.iconBg};`}>
  <div class="learn-header__top">
    <div class="learn-header__icon-wrap">
      {/* Microsoft product SVG icons */}
      {app === 'word' && (
        <svg class="learn-header__icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="6" fill="#185ABD"/>
          <path d="M7 8h8v2.5H9.5V15H14v2.5H9.5V22H15v2.5H7V8z" fill="white" opacity="0.5"/>
          <path d="M11 10l2.8 12h2.4l2-7.5 2 7.5h2.4L25.4 10h-2.6l-1.6 7.2-2-7.2h-2.2l-2 7.2L13.4 10H11z" fill="white"/>
        </svg>
      )}
      {app === 'excel' && (
        <svg class="learn-header__icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="6" fill="#107C41"/>
          <path d="M19 8h6v16h-6v-3h3.5v-2H19v-2h3.5v-2H19v-2h3.5v-2H19V8z" fill="white" opacity="0.5"/>
          <path d="M7 10l3.5 6L7 22h3.2l2-3.8L14.2 22h3.2l-3.6-6 3.6-6h-3.2l-2 3.8L10.2 10H7z" fill="white"/>
        </svg>
      )}
      {app === 'powerpoint' && (
        <svg class="learn-header__icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="6" fill="#C43E1C"/>
          <path d="M11 10h5.5c2.8 0 4.5 1.6 4.5 4s-1.7 4-4.5 4H14v5h-3V10zm3 2.5v3h2c1 0 1.8-.6 1.8-1.5s-.8-1.5-1.8-1.5h-2z" fill="white"/>
        </svg>
      )}
      {app === 'outlook' && (
        <svg class="learn-header__icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="6" fill="#0078D4"/>
          <path d="M6 10.5L16 7v18l-10-3.5V10.5z" fill="white" opacity="0.4"/>
          <path d="M16 9h10v14H16V9zm1 1l4.5 4L26 10H17zm0 1.5V22h9V11.5l-4.5 4-4.5-4z" fill="white"/>
          <ellipse cx="11" cy="16" rx="3.2" ry="3.8" fill="none" stroke="white" stroke-width="1.5"/>
        </svg>
      )}
      {app === 'teams' && (
        <svg class="learn-header__icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="6" fill="#6264A7"/>
          <circle cx="20.5" cy="10.5" r="2.5" fill="white" opacity="0.6"/>
          <rect x="18" y="14" width="8" height="8" rx="1.5" fill="white" opacity="0.4"/>
          <circle cx="13" cy="10" r="3" fill="white"/>
          <rect x="7" y="13.5" width="12" height="10" rx="2" fill="white"/>
          <path d="M10 17h6M10 20h4" stroke="#6264A7" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
      )}
      {app === 'onenote' && (
        <svg class="learn-header__icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="6" fill="#7719AA"/>
          <rect x="18" y="7" width="7" height="18" rx="1.5" fill="white" opacity="0.35"/>
          <rect x="7" y="8" width="14" height="16" rx="2" fill="white"/>
          <path d="M10 11h1.5l3 6.5V11H16v10h-1.5l-3-6.5V21H10V11z" fill="#7719AA"/>
        </svg>
      )}
      {app === 'forms' && (
        <svg class="learn-header__icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="6" fill="#077568"/>
          <rect x="8" y="7" width="16" height="18" rx="2" fill="white"/>
          <rect x="11" y="10" width="5" height="2" rx="0.5" fill="#077568"/>
          <rect x="11" y="14" width="8" height="2" rx="0.5" fill="#077568" opacity="0.4"/>
          <rect x="11" y="18" width="6" height="2" rx="0.5" fill="#077568" opacity="0.4"/>
          <circle cx="21" cy="21" r="5" fill="#077568"/>
          <path d="M19 21l1.5 1.5L23 19.5" stroke="white" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      )}
      {app === 'whiteboard' && (
        <svg class="learn-header__icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="6" fill="#2B88D8"/>
          <rect x="6" y="8" width="20" height="14" rx="2" fill="white"/>
          <path d="M10 15c2-3 4-3 6 0s4 3 6 0" stroke="#2B88D8" stroke-width="1.5" stroke-linecap="round" fill="none"/>
          <rect x="14" y="22" width="4" height="2" rx="0.5" fill="white"/>
        </svg>
      )}
      {app === 'onedrive' && (
        <svg class="learn-header__icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="6" fill="#0078D4"/>
          <path d="M12 21h13c2.2 0 3-1.5 3-3s-1.2-3-3-3c0-3-2.5-5-5.5-5-2 0-3.8 1.2-4.5 3-0.5-0.3-1-0.4-1.5-0.4C11.5 12.6 10 14 10 16c-1.8 0.2-3 1.5-3 3 0 1.5 1.2 2 3 2h2z" fill="white"/>
        </svg>
      )}
      {app === 'planner' && (
        <svg class="learn-header__icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="6" fill="#31752F"/>
          <rect x="7" y="9" width="8" height="8" rx="1.5" fill="white"/>
          <rect x="17" y="9" width="8" height="8" rx="1.5" fill="white" opacity="0.6"/>
          <rect x="7" y="19" width="8" height="5" rx="1.5" fill="white" opacity="0.6"/>
          <rect x="17" y="19" width="8" height="5" rx="1.5" fill="white" opacity="0.35"/>
          <path d="M9.5 12.5l1.5 1.5 3-3" stroke="#31752F" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      )}
      {/* ── Agent icons ──────────────────────────────── */}
      {app === 'researcher' && (
        <svg class="learn-header__icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="6" fill="#6B4FBB"/>
          <circle cx="14" cy="14" r="5" stroke="white" stroke-width="2" fill="none"/>
          <path d="M18 18l5.5 5.5" stroke="white" stroke-width="2" stroke-linecap="round"/>
          <path d="M12 12l1 4 2-2 2 1" stroke="white" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      )}
      {app === 'analyst' && (
        <svg class="learn-header__icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="6" fill="#0E7A0D"/>
          <rect x="8" y="19" width="3.5" height="5" rx="0.8" fill="white"/>
          <rect x="13" y="15" width="3.5" height="9" rx="0.8" fill="white"/>
          <rect x="18" y="11" width="3.5" height="13" rx="0.8" fill="white"/>
          <path d="M9 10l4 3 4-4 5 3" stroke="white" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" opacity="0.7"/>
        </svg>
      )}
      {app === 'cowork' && (
        <svg class="learn-header__icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="6" fill="#0078D4"/>
          <circle cx="12" cy="12" r="3" fill="white"/>
          <circle cx="20" cy="12" r="3" fill="white" opacity="0.6"/>
          <path d="M7 22c0-3 2.5-5 5-5s5 2 5 5" fill="white"/>
          <path d="M17 22c0-3 2.5-5 5-5s5 2 5 5" fill="white" opacity="0.5"/>
          <path d="M14 17l2-1.5 2 1.5" stroke="white" stroke-width="1.2" stroke-linecap="round" fill="none"/>
        </svg>
      )}
      {app === 'agent-builder' && (
        <svg class="learn-header__icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="6" fill="#8661C5"/>
          <rect x="8" y="8" width="16" height="12" rx="2.5" fill="white"/>
          <circle cx="13" cy="13" r="1.5" fill="#8661C5"/>
          <circle cx="19" cy="13" r="1.5" fill="#8661C5"/>
          <path d="M12 16.5c0 0 1.5 2 4 2s4-2 4-2" stroke="#8661C5" stroke-width="1.2" stroke-linecap="round" fill="none"/>
          <rect x="13" y="21" width="6" height="3" rx="1" fill="white"/>
        </svg>
      )}
      {app === 'copilot-chat' && (
        <svg class="learn-header__icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="6" fill="#6264A7"/>
          <path d="M8 11c0-1.1.9-2 2-2h12c1.1 0 2 .9 2 2v7c0 1.1-.9 2-2 2h-3l-3 3-3-3h-3c-1.1 0-2-.9-2-2v-7z" fill="white"/>
          <circle cx="12.5" cy="14.5" r="1" fill="#6264A7"/>
          <circle cx="16" cy="14.5" r="1" fill="#6264A7"/>
          <circle cx="19.5" cy="14.5" r="1" fill="#6264A7"/>
          <path d="M14 8l2-2.5L18 8" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.6"/>
        </svg>
      )}
    </div>

    <div class="learn-header__meta">
      <span class="learn-header__badge">{meta.category}</span>
      <h1 class="learn-header__title">{meta.name}</h1>
      <p class="learn-header__desc">{meta.description}</p>
    </div>
  </div>

  <div class="learn-header__info-bar">
    <div class="learn-header__info-item">
      <svg viewBox="0 0 16 16" fill="none"><path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 1a6 6 0 1 1 0 12A6 6 0 0 1 8 2zm-.5 2v4.3l3 1.8.5-.9-2.5-1.5V4h-1z" fill="currentColor"/></svg>
      <span>5 phút đọc</span>
    </div>
    <div class="learn-header__info-item">
      <svg viewBox="0 0 16 16" fill="none"><path d="M8 1C4.1 1 1 4.1 1 8s3.1 7 7 7 7-3.1 7-7-3.1-7-7-7zm0 1c3.3 0 6 2.7 6 6s-2.7 6-6 6-6-2.7-6-6 2.7-6 6-6zm-1 3v2H5v2h2v2h2v-2h2V7H9V5H7z" fill="currentColor"/></svg>
      <span>Microsoft 365 Copilot license</span>
    </div>
    <div class="learn-header__info-item">
      <svg viewBox="0 0 16 16" fill="none"><path d="M3 2a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1H3zm0 1h10v10H3V3zm2 2v1h6V5H5zm0 3v1h4V8H5zm0 3v1h5v-1H5z" fill="currentColor"/></svg>
      <span>Hướng dẫn thực hành</span>
    </div>
  </div>
</div>

<style>
  .learn-header {
    --lh-surface: #fff;
    --lh-border: #e1e1e1;
    --lh-text: #242424;
    --lh-text-muted: #616161;
    margin-block-end: 1.5rem;
  }

  .learn-header__top {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding-block-end: 1.5rem;
    border-block-end: 1px solid var(--lh-border);
  }

  .learn-header__icon-wrap {
    flex: none;
  }

  .learn-header__icon {
    width: 56px;
    height: 56px;
    border-radius: 10px;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.12));
  }

  .learn-header__meta {
    min-width: 0;
  }

  .learn-header__badge {
    display: inline-block;
    margin-block-end: 0.35rem;
    padding: 0.15rem 0.55rem;
    border-radius: 2px;
    background: color-mix(in srgb, var(--lh-accent) 12%, transparent);
    color: var(--lh-accent);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .learn-header__title {
    margin: 0 0 0.35rem;
    color: var(--lh-text);
    font-size: 1.65rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .learn-header__desc {
    max-width: 60ch;
    margin: 0;
    color: var(--lh-text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .learn-header__info-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding-block: 0.75rem;
    border-block-end: 1px solid var(--lh-border);
  }

  .learn-header__info-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--lh-text-muted);
    font-size: 0.78rem;
  }

  .learn-header__info-item svg {
    width: 14px;
    height: 14px;
    flex: none;
    color: var(--lh-accent);
  }

  /* ── Dark mode ── */
  :global([data-theme='dark']) .learn-header {
    --lh-surface: #1a1a1a;
    --lh-border: #404040;
    --lh-text: #f0f0f0;
    --lh-text-muted: #b0b0b0;
  }

  :global([data-theme='dark']) .learn-header__badge {
    background: color-mix(in srgb, var(--lh-accent) 20%, transparent);
  }

  :global([data-theme='dark']) .learn-header__icon {
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.3));
  }

  /* ── Responsive ── */
  @media (max-width: 480px) {
    .learn-header__top {
      flex-direction: column;
      gap: 0.85rem;
    }

    .learn-header__title {
      font-size: 1.35rem;
    }

    .learn-header__info-bar {
      flex-direction: column;
      gap: 0.6rem;
    }
  }
</style>
