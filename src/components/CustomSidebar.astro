---
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro';

const { sidebar } = Astro.locals.starlightRoute;

function getItemKey(href: string = '', label: string = ''): string {
  const h = href.toLowerCase();
  const l = label.toLowerCase();
  
  if (h.includes('/apps/word') || l === 'word') return 'word';
  if (h.includes('/apps/excel') || l === 'excel') return 'excel';
  if (h.includes('/apps/powerpoint') || l === 'powerpoint') return 'powerpoint';
  if (h.includes('/apps/outlook') || l === 'outlook') return 'outlook';
  if (h.includes('/apps/teams') || l === 'teams') return 'teams';
  if (h.includes('/apps/onenote') || l === 'onenote') return 'onenote';
  if (h.includes('/apps/forms') || l === 'forms') return 'forms';
  if (h.includes('/apps/whiteboard') || l === 'whiteboard') return 'whiteboard';
  if (h.includes('/apps/onedrive') || l === 'onedrive') return 'onedrive';
  if (h.includes('/apps/planner') || l === 'planner') return 'planner';
  if (h.includes('/agents/researcher') || l === 'researcher') return 'researcher';
  if (h.includes('/agents/analyst') || l === 'analyst') return 'analyst';
  if (h.includes('/agents/cowork') || l === 'cowork') return 'cowork';
  if (h.includes('/agents/agent-builder') || l.includes('agent builder')) return 'agent-builder';
  if (h.includes('/copilot-chat') || l.includes('copilot chat')) return 'copilot-chat';
  if (h.includes('/quick-wins') || l.includes('quick wins')) return 'quick-wins';
  if (h.includes('/use-cases') || l.includes('use case')) return 'use-cases';
  if (h === '/' || h === '/en/' || l.includes('tổng quan') || l.includes('overview')) return 'overview';
  
  return 'default';
}

function hasActiveChild(group: any): boolean {
  if (!group || !group.entries) return false;
  return group.entries.some((entry: any) => {
    if (entry.type === 'link') return Boolean(entry.isCurrent);
    if (entry.type === 'group') return hasActiveChild(entry);
    return false;
  });
}
---

<SidebarPersister>
  <nav class="custom-sidebar" aria-label="Main Navigation">
    {sidebar.map((group: any) => (
      <div class="sidebar-section">
        {group.type === 'group' ? (
          <div class="group-container">
            <div class="section-title">
              <span>{group.label}</span>
              {group.badge && (
                <span class="custom-badge">{typeof group.badge === 'string' ? group.badge : group.badge.text}</span>
              )}
            </div>
            <ul class="nav-list">
              {group.entries.map((entry: any) => {
                if (entry.type === 'link') {
                  const key = getItemKey(entry.href, entry.label);
                  return (
                    <li class="nav-item">
                      <a
                        href={entry.href}
                        aria-current={entry.isCurrent ? 'page' : undefined}
                        class:list={['nav-link', { 'is-active': entry.isCurrent }]}
                        {...entry.attrs}
                      >
                        <span class="icon-wrapper">
                          {/* ── Microsoft SVG Icons ── */}
                          {key === 'word' && (
                            <svg class="app-svg" viewBox="0 0 24 24" fill="none">
                              <rect width="24" height="24" rx="4.5" fill="#185ABD"/>
                              <path d="M5.5 6.5h6v1.8H7.5V11h3.5v1.8H7.5v2.7h4v1.8H5.5V6.5z" fill="white" opacity="0.45"/>
                              <path d="M8.5 8l2.2 8.5h1.8l1.6-5.5 1.6 5.5h1.8L19.5 8h-2l-1.3 5.2-1.6-5.2h-1.6l-1.6 5.2L10.5 8H8.5z" fill="white"/>
                            </svg>
                          )}
                          {key === 'excel' && (
                            <svg class="app-svg" viewBox="0 0 24 24" fill="none">
                              <rect width="24" height="24" rx="4.5" fill="#107C41"/>
                              <path d="M14 6h5v12h-5v-2.2h2.8v-1.5H14v-1.5h2.8v-1.5H14v-1.5h2.8V7.5H14V6z" fill="white" opacity="0.45"/>
                              <path d="M5.5 7.5l2.8 4.5-2.8 4.5h2.4l1.6-2.8 1.6 2.8h2.4l-2.8-4.5 2.8-4.5h-2.4l-1.6 2.8-1.6-2.8H5.5z" fill="white"/>
                            </svg>
                          )}
                          {key === 'powerpoint' && (
                            <svg class="app-svg" viewBox="0 0 24 24" fill="none">
                              <rect width="24" height="24" rx="4.5" fill="#C43E1C"/>
                              <path d="M8 7.5h4.5c2.2 0 3.5 1.3 3.5 3.2s-1.3 3.2-3.5 3.2H10.5v3.5H8V7.5zm2.5 2v2.4h1.8c1 0 1.5-.5 1.5-1.2s-.5-1.2-1.5-1.2h-1.8z" fill="white"/>
                            </svg>
                          )}
                          {key === 'outlook' && (
                            <svg class="app-svg" viewBox="0 0 24 24" fill="none">
                              <rect width="24" height="24" rx="4.5" fill="#0078D4"/>
                              <path d="M5 8l7.5-2.5v13L5 16V8z" fill="white" opacity="0.35"/>
                              <path d="M12.5 7h7.5v10.5h-7.5V7zm.8.8l3 2.7 3-2.7h-6zm0 1.2v7.7h6.7V9.7l-3.3 3-3.4-3z" fill="white"/>
                              <ellipse cx="8.8" cy="12" rx="2.4" ry="2.8" fill="none" stroke="white" stroke-width="1.2"/>
                            </svg>
                          )}
                          {key === 'teams' && (
                            <svg class="app-svg" viewBox="0 0 24 24" fill="none">
                              <rect width="24" height="24" rx="4.5" fill="#6264A7"/>
                              <circle cx="15.5" cy="8" r="2" fill="white" opacity="0.5"/>
                              <rect x="13.5" y="10.5" width="6" height="6" rx="1" fill="white" opacity="0.35"/>
                              <circle cx="9.8" cy="7.5" r="2.3" fill="white"/>
                              <rect x="5.2" y="10.2" width="9" height="7.5" rx="1.5" fill="white"/>
                              <path d="M7.8 13h4M7.8 15.2h2.8" stroke="#6264A7" stroke-width="1" stroke-linecap="round"/>
                            </svg>
                          )}
                          {key === 'onenote' && (
                            <svg class="app-svg" viewBox="0 0 24 24" fill="none">
                              <rect width="24" height="24" rx="4.5" fill="#7719AA"/>
                              <rect x="13.5" y="5.5" width="5.5" height="13" rx="1" fill="white" opacity="0.35"/>
                              <rect x="5.5" y="6" width="10.5" height="12" rx="1.5" fill="white"/>
                              <path d="M7.8 8.5h1.2l2.4 5V8.5h1.2v7h-1.2l-2.4-5v5H7.8v-7z" fill="#7719AA"/>
                            </svg>
                          )}
                          {key === 'forms' && (
                            <svg class="app-svg" viewBox="0 0 24 24" fill="none">
                              <rect width="24" height="24" rx="4.5" fill="#077568"/>
                              <rect x="6" y="5.5" width="12" height="13" rx="1.5" fill="white"/>
                              <rect x="8.5" y="7.8" width="4" height="1.5" rx="0.4" fill="#077568"/>
                              <rect x="8.5" y="10.8" width="6" height="1.5" rx="0.4" fill="#077568" opacity="0.4"/>
                              <rect x="8.5" y="13.8" width="4.5" height="1.5" rx="0.4" fill="#077568" opacity="0.4"/>
                              <circle cx="15.8" cy="15.8" r="3.8" fill="#077568"/>
                              <path d="M14.5 15.8l1 1 2-2" stroke="white" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          )}
                          {key === 'whiteboard' && (
                            <svg class="app-svg" viewBox="0 0 24 24" fill="none">
                              <rect width="24" height="24" rx="4.5" fill="#2B88D8"/>
                              <rect x="4.5" y="6" width="15" height="10.5" rx="1.5" fill="white"/>
                              <path d="M7.5 11.5c1.5-2.2 3-2.2 4.5 0s3 2.2 4.5 0" stroke="#2B88D8" stroke-width="1.2" stroke-linecap="round" fill="none"/>
                              <rect x="10.5" y="16.5" width="3" height="1.5" rx="0.4" fill="white"/>
                            </svg>
                          )}
                          {key === 'onedrive' && (
                            <svg class="app-svg" viewBox="0 0 24 24" fill="none">
                              <rect width="24" height="24" rx="4.5" fill="#0078D4"/>
                              <path d="M9 16h10c1.7 0 2.3-1.1 2.3-2.3 0-1-.9-2.3-2.3-2.3 0-2.3-1.9-3.8-4.2-3.8-1.5 0-2.9.9-3.4 2.3-.4-.2-.8-.3-1.2-.3-1.5 0-2.7 1.1-2.7 2.6-1.4.1-2.3 1.1-2.3 2.3 0 1.1.9 1.5 2.3 1.5h1.5z" fill="white"/>
                            </svg>
                          )}
                          {key === 'planner' && (
                            <svg class="app-svg" viewBox="0 0 24 24" fill="none">
                              <rect width="24" height="24" rx="4.5" fill="#31752F"/>
                              <rect x="5.5" y="7" width="6" height="6" rx="1" fill="white"/>
                              <rect x="12.5" y="7" width="6" height="6" rx="1" fill="white" opacity="0.6"/>
                              <rect x="5.5" y="14" width="6" height="3.5" rx="1" fill="white" opacity="0.6"/>
                              <rect x="12.5" y="14" width="6" height="3.5" rx="1" fill="white" opacity="0.35"/>
                              <path d="M7.5 9.5l1 1 2.2-2.2" stroke="#31752F" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          )}
                          {/* ── Agents SVGs ── */}
                          {key === 'researcher' && (
                            <svg class="app-svg" viewBox="0 0 24 24" fill="none">
                              <defs>
                                <linearGradient id="resGrad" x1="0" y1="0" x2="24" y2="24" gradientUnits="userSpaceOnUse">
                                  <stop stop-color="#00D2FF"/>
                                  <stop offset="1" stop-color="#7B2CBF"/>
                                </linearGradient>
                              </defs>
                              <circle cx="12" cy="12" r="10.5" fill="url(#resGrad)"/>
                              <ellipse cx="12" cy="12" rx="7" ry="2.8" transform="rotate(-25 12 12)" stroke="white" stroke-width="1.3" fill="none" opacity="0.9"/>
                              <circle cx="12" cy="12" r="2" fill="white"/>
                            </svg>
                          )}
                          {key === 'analyst' && (
                            <svg class="app-svg" viewBox="0 0 24 24" fill="none">
                              <defs>
                                <linearGradient id="anaGrad" x1="0" y1="0" x2="24" y2="24" gradientUnits="userSpaceOnUse">
                                  <stop stop-color="#00C9FF"/>
                                  <stop offset="1" stop-color="#92FE9D"/>
                                </linearGradient>
                              </defs>
                              <rect width="24" height="24" rx="6" fill="#0D5C3A"/>
                              <circle cx="7.5" cy="15.5" r="2" fill="#92FE9D"/>
                              <circle cx="12" cy="11.5" r="2" fill="#00C9FF"/>
                              <circle cx="16.5" cy="7.5" r="2" fill="#ffffff"/>
                              <path d="M7.5 15.5L12 11.5L16.5 7.5" stroke="white" stroke-width="1.4" stroke-linecap="round" opacity="0.8"/>
                            </svg>
                          )}
                          {key === 'cowork' && (
                            <svg class="app-svg" viewBox="0 0 24 24" fill="none">
                              <defs>
                                <linearGradient id="cw1" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#FF5722"/><stop offset="1" stop-color="#FF9800"/></linearGradient>
                                <linearGradient id="cw2" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#00B0FF"/><stop offset="1" stop-color="#2979FF"/></linearGradient>
                                <linearGradient id="cw3" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#00E676"/><stop offset="1" stop-color="#00B0FF"/></linearGradient>
                                <linearGradient id="cw4" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#FF4081"/><stop offset="1" stop-color="#7C4DFF"/></linearGradient>
                              </defs>
                              <circle cx="12" cy="12" r="10.5" fill="#181D28"/>
                              <path d="M12 4.5C9 4.5 7 7 7 10c0 2 1.5 3.5 3 4.5l2-2.5V4.5z" fill="url(#cw1)"/>
                              <path d="M19.5 12c0-3-2.5-5-5.5-5-2 0-3.5 1.5-4.5 3l2.5 2h7.5z" fill="url(#cw2)"/>
                              <path d="M12 19.5c3 0 5-2.5 5-5.5 0-2-1.5-3.5-3-4.5l-2 2.5v7.5z" fill="url(#cw3)"/>
                              <path d="M4.5 12c0 3 2.5 5 5.5 5 2 0 3.5-1.5 4.5-3l-2.5-2H4.5z" fill="url(#cw4)"/>
                            </svg>
                          )}
                          {key === 'agent-builder' && (
                            <svg class="app-svg" viewBox="0 0 24 24" fill="none">
                              <rect width="24" height="24" rx="6" fill="#0284C7"/>
                              <path d="M12 4.5v2.5M10.5 4.5h3" stroke="white" stroke-width="1.3" stroke-linecap="round"/>
                              <rect x="6" y="7" width="12" height="9" rx="2" fill="white"/>
                              <circle cx="9.5" cy="10.8" r="1.2" fill="#0284C7"/>
                              <circle cx="14.5" cy="10.8" r="1.2" fill="#0284C7"/>
                              <path d="M9.5 13.5h5" stroke="#0284C7" stroke-width="1.2" stroke-linecap="round"/>
                              <rect x="10" y="16" width="4" height="2" rx="0.5" fill="white"/>
                            </svg>
                          )}
                          {/* ── Exploration / General SVGs ── */}
                          {key === 'copilot-chat' && (
                            <svg class="app-svg" viewBox="0 0 24 24" fill="none">
                              <defs>
                                <linearGradient id="cChatGrad" x1="0" y1="0" x2="24" y2="24" gradientUnits="userSpaceOnUse">
                                  <stop stop-color="#0078D4"/>
                                  <stop offset="0.5" stop-color="#6264A7"/>
                                  <stop offset="1" stop-color="#D83B01"/>
                                </linearGradient>
                              </defs>
                              <rect width="24" height="24" rx="5" fill="url(#cChatGrad)"/>
                              <path d="M6.5 8.5c0-.8.7-1.5 1.5-1.5h8c.8 0 1.5.7 1.5 1.5v5c0 .8-.7 1.5-1.5 1.5h-2.5l-2.5 2.5-2.5-2.5H8c-.8 0-1.5-.7-1.5-1.5v-5z" fill="white"/>
                              <circle cx="9.5" cy="11" r="0.8" fill="#6264A7"/>
                              <circle cx="12" cy="11" r="0.8" fill="#6264A7"/>
                              <circle cx="14.5" cy="11" r="0.8" fill="#6264A7"/>
                            </svg>
                          )}
                          {key === 'overview' && (
                            <svg class="app-svg" viewBox="0 0 24 24" fill="none">
                              <rect width="24" height="24" rx="5" fill="#0F6CBD"/>
                              <path d="M6 10.5L12 6l6 4.5v7.5a1 1 0 01-1 1h-3.5v-4.5h-3V19H7a1 1 0 01-1-1v-7.5z" fill="white"/>
                            </svg>
                          )}
                          {key === 'use-cases' && (
                            <svg class="app-svg" viewBox="0 0 24 24" fill="none">
                              <rect width="24" height="24" rx="5" fill="#4F52B2"/>
                              <rect x="5.5" y="7.5" width="13" height="10" rx="1.5" fill="white"/>
                              <path d="M9 7.5V6a1.5 1.5 0 011.5-1.5h3A1.5 1.5 0 0115 6v1.5" stroke="white" stroke-width="1.3"/>
                              <path d="M5.5 12h13" stroke="#4F52B2" stroke-width="1.2"/>
                              <rect x="10.5" y="11" width="3" height="2" rx="0.5" fill="#4F52B2"/>
                            </svg>
                          )}
                          {key === 'quick-wins' && (
                            <svg class="app-svg" viewBox="0 0 24 24" fill="none">
                              <rect width="24" height="24" rx="5" fill="#D83B01"/>
                              <path d="M12 5.5l1.8 4.2 4.5.4-3.4 3 1 4.4-3.9-2.3-3.9 2.3 1-4.4-3.4-3 4.5-.4L12 5.5z" fill="white"/>
                            </svg>
                          )}
                          {key === 'default' && (
                            <svg class="app-svg" viewBox="0 0 24 24" fill="none">
                              <rect width="24" height="24" rx="5" fill="#605E5C"/>
                              <circle cx="12" cy="12" r="3" fill="white"/>
                            </svg>
                          )}
                        </span>
                        <span class="link-label">{entry.label}</span>
                        {entry.badge && (
                          <span class="custom-badge">{typeof entry.badge === 'string' ? entry.badge : entry.badge.text}</span>
                        )}
                      </a>
                    </li>
                  );
                } else {
                  return (
                    <li>
                      <details open={hasActiveChild(entry) || !entry.collapsed}>
                        <summary>
                          <span class="nested-group-label">{entry.label}</span>
                          <svg class="caret-icon" viewBox="0 0 16 16" fill="none">
                            <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </summary>
                        <SidebarRestorePoint />
                        <ul class="nested-list">
                          {entry.entries?.map((nestedEntry: any) => (
                            <li>
                              {nestedEntry.type === 'link' ? (
                                <a
                                  href={nestedEntry.href}
                                  aria-current={nestedEntry.isCurrent ? 'page' : undefined}
                                  class:list={['nav-link', { 'is-active': nestedEntry.isCurrent }]}
                                  {...nestedEntry.attrs}
                                >
                                  <span class="link-label">{nestedEntry.label}</span>
                                </a>
                              ) : null}
                            </li>
                          ))}
                        </ul>
                      </details>
                    </li>
                  );
                }
              })}
            </ul>
          </div>
        ) : (
          <a
            href={group.href}
            aria-current={group.isCurrent ? 'page' : undefined}
            class:list={['nav-link', 'standalone-link', { 'is-active': group.isCurrent }]}
            {...group.attrs}
          >
            <span class="link-label">{group.label}</span>
          </a>
        )}
      </div>
    ))}
  </nav>
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  .custom-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 0.5rem 0.2rem 4rem;
    user-select: none;
  }

  .sidebar-section {
    display: flex;
    flex-direction: column;
  }

  .section-title {
    font-size: 0.72rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--cp-text-soft, #71717a);
    padding: 0.35rem 0.65rem 0.45rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  :global([data-theme='dark']) .section-title {
    color: #94a3b8;
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .nav-item {
    margin: 0;
    padding: 0;
  }

  .nav-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.48rem 0.7rem;
    border-radius: 6px;
    text-decoration: none;
    color: var(--cp-text, #27272a);
    font-size: 0.88rem;
    font-weight: 500;
    line-height: 1.3;
    transition: background-color 120ms ease, color 120ms ease;
  }

  :global([data-theme='dark']) .nav-link {
    color: #cbd5e1;
  }

  .nav-link:hover {
    background-color: var(--cp-surface-soft, rgba(0, 0, 0, 0.04));
    color: var(--cp-text, #0f172a);
  }

  :global([data-theme='dark']) .nav-link:hover {
    background-color: rgba(255, 255, 255, 0.06);
    color: #ffffff;
  }

  /* ── Active State matching Microsoft Learn / Copilot Portal ── */
  .nav-link.is-active,
  .nav-link[aria-current='page'] {
    background-color: #eef2ff !important;
    color: #005fb8 !important;
    font-weight: 700 !important;
  }

  :global([data-theme='dark']) .nav-link.is-active,
  :global([data-theme='dark']) .nav-link[aria-current='page'] {
    background-color: rgba(14, 116, 219, 0.2) !important;
    color: #60a5fa !important;
  }

  /* Left accent indicator bar for active item */
  .nav-link.is-active::before,
  .nav-link[aria-current='page']::before {
    content: '';
    position: absolute;
    left: 0px;
    top: 15%;
    bottom: 15%;
    width: 3.5px;
    border-radius: 4px;
    background-color: #005fb8;
  }

  :global([data-theme='dark']) .nav-link.is-active::before,
  :global([data-theme='dark']) .nav-link[aria-current='page']::before {
    background-color: #38bdf8;
  }

  .icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .app-svg {
    width: 20px;
    height: 20px;
    display: block;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.1));
  }

  .link-label {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .custom-badge {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    background: #e0e7ff;
    color: #3730a3;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.35rem 0.6rem;
    cursor: pointer;
    border-radius: 5px;
    color: var(--cp-text-muted, #52525b);
    font-size: 0.84rem;
    font-weight: 600;
  }

  summary:hover {
    background-color: var(--cp-surface-soft, rgba(0, 0, 0, 0.04));
  }

  summary::marker,
  summary::-webkit-details-marker {
    display: none;
  }

  .nested-list {
    list-style: none;
    margin: 0.2rem 0 0.3rem 1.2rem;
    padding: 0 0 0 0.5rem;
    border-left: 1px solid var(--cp-border, #e4e4e7);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .caret-icon {
    width: 14px;
