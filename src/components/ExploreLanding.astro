---
import { getCollection } from 'astro:content';

const { locale = 'vi', kind = 'departments', department = '' } = Astro.props;
const isEnglish = locale === 'en';
const language = isEnglish ? 'en' : 'vi';
const entries = await getCollection('docs');
const departments: Record<string, Record<string, { label: string; description: string }>> = {
  banking: {
    vi: { label: 'Ngân hàng', description: 'Nghiên cứu thị trường và rà soát hồ sơ tín dụng.' },
    en: { label: 'Banking', description: 'Market research and credit-file review.' },
  },
  hr: {
    vi: { label: 'Nhân sự', description: 'Hội nhập nhân viên mới và chuẩn bị phỏng vấn.' },
    en: { label: 'Human Resources', description: 'Employee onboarding and interview preparation.' },
  },
  sales: {
    vi: { label: 'Bán hàng', description: 'Chuẩn bị thông tin khách hàng và theo dõi sau cuộc họp.' },
    en: { label: 'Sales', description: 'Prepare account briefs and follow up after meetings.' },
  },
};
const cases = entries
  .filter(({ id, data }) => Boolean(data.department) && (isEnglish ? id.startsWith('en/') : !id.startsWith('en/')))
  .map(({ id, data }) => ({
    title: data.title,
    description: data.description,
    department: data.department,
    level: data.level,
    experience: data.experience,
    href: `/${id.replace(/\.(md|mdx)$/, '')}/`,
  }));
const labels = isEnglish
  ? {
      quickWinsTitle: 'Quick starts ready to try',
      quickWinsDescription: 'Beginner-friendly use cases with a clear first step.',
      departmentTitle: 'Choose a department',
      departmentDescription: 'Browse practical scenarios by the team and work they support.',
      caseTitle: `${departments[department]?.[language]?.label ?? 'Department'} use cases`,
      caseDescription: 'Open a scenario to review its expected outcome and sample prompt.',
      cases: 'use cases',
      beginner: 'Beginner',
      intermediate: 'Intermediate',
      advanced: 'Advanced',
      view: 'View scenarios',
      open: 'Open use case',
      back: 'Browse all use cases',
      empty: 'No use cases have been added here yet.',
    }
  : {
      quickWinsTitle: 'Tình huống dễ bắt đầu',
      quickWinsDescription: 'Các use case mức cơ bản, có thể dùng làm điểm khởi đầu.',
      departmentTitle: 'Chọn phòng ban',
      departmentDescription: 'Duyệt tình huống theo nhóm công việc và nhu cầu của từng phòng ban.',
      caseTitle: `Use case ${departments[department]?.vi?.label ?? ''}`,
      caseDescription: 'Mở tình huống để xem kết quả kỳ vọng và prompt mẫu.',
      cases: 'tình huống',
      beginner: 'Cơ bản',
      intermediate: 'Trung cấp',
      advanced: 'Nâng cao',
      view: 'Xem tình huống',
      open: 'Mở use case',
      back: 'Duyệt tất cả use case',
      empty: 'Chưa có use case trong mục này.',
    };
const departmentLabels: Record<string, string> = Object.fromEntries(
  Object.entries(departments).map(([key, value]) => [key, value[language].label]),
);
const departmentCases = Object.fromEntries(
  Object.keys(departments).map((key) => [key, cases.filter((item) => item.department === key)]),
);
const visibleCases = kind === 'quick-wins'
  ? cases.filter((item) => item.level === 'beginner').slice(0, 10)
  : cases.filter((item) => item.department === department);
const levelLabels: Record<string, string> = {
  beginner: labels.beginner,
  intermediate: labels.intermediate,
  advanced: labels.advanced,
};
const homeHref = isEnglish ? '/en/' : '/';
---

<section class="landing" aria-labelledby="landing-title">
  {kind === 'departments' ? (
    <>
      <header class="landing-head">
        <div>
          <p class="eyebrow">{isEnglish ? 'USE CASE LIBRARY' : 'THƯ VIỆN TÌNH HUỐNG'}</p>
          <h2 id="landing-title">{labels.departmentTitle}</h2>
          <p>{labels.departmentDescription}</p>
        </div>
        <strong class="total-count">{cases.length}<span>{labels.cases}</span></strong>
      </header>
      <div class="department-grid">
        {Object.entries(departments).map(([key, localized]) => {
          const departmentInfo = localized[language];
          const count = departmentCases[key].length;
          const href = `${isEnglish ? '/en' : ''}/departments/${key}/`;
          return (
            <a class="department-card" href={href}>
              <span class="card-count">{count} {labels.cases}</span>
              <h3>{departmentInfo.label}</h3>
              <p>{departmentInfo.description}</p>
              <span class="card-link">{labels.view}<span aria-hidden="true">→</span></span>
            </a>
          );
        })}
      </div>
    </>
  ) : (
    <>
      <header class="landing-head">
        <div>
          <p class="eyebrow">{kind === 'quick-wins' ? 'QUICK WINS' : departmentLabels[department]}</p>
          <h2 id="landing-title">{kind === 'quick-wins' ? labels.quickWinsTitle : labels.caseTitle}</h2>
          <p>{kind === 'quick-wins' ? labels.quickWinsDescription : labels.caseDescription}</p>
        </div>
        <strong class="total-count">{visibleCases.length}<span>{labels.cases}</span></strong>
      </header>
      {visibleCases.length ? (
        <div class="case-list">
          {visibleCases.map((item) => (
            <article class="case-row">
              <div class="case-copy">
                <span class={`department-tag department-${item.department ?? 'other'}`}>{departmentLabels[item.department ?? '']}</span>
                <h3><a href={item.href}>{item.title}</a></h3>
                <p>{item.description}</p>
                <div class="case-meta">
                  <span>{levelLabels[item.level ?? ''] ?? item.level}</span>
                  <span>{item.experience}</span>
                </div>
              </div>
              <a class="open-link" href={item.href} aria-label={`${labels.open}: ${item.title}`}>
                <span>{labels.open}</span><span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <p class="empty-state">{labels.empty}</p>
      )}
    </>
  )}

  <a class="back-link" href={homeHref}>{labels.back}<span aria-hidden="true">→</span></a>
</section>

<style>
  .landing {
    --landing-ink: #111111;
    --landing-muted: #555555;
    --landing-line: #d8d8d8;
    --landing-surface: #fff;
    --landing-wash: #f4f4f4;
    --landing-blue: #111111;
    --landing-teal: #111111;
    margin: 2rem auto 3rem;
    color: var(--landing-ink);
  }
  .landing-head { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-block-end: 1.5rem; }
  .eyebrow { margin: 0 0 .55rem; color: var(--landing-teal); font-size: .72rem; font-weight: 800; letter-spacing: .12em; }
  .landing-head h2 { margin: 0; color: var(--landing-ink); font-size: 1.8rem; line-height: 1.18; }
  .landing-head p:not(.eyebrow) { max-width: 62ch; margin: .6rem 0 0; color: var(--landing-muted); line-height: 1.6; }
  .total-count { display: grid; min-width: 94px; padding: .7rem .9rem; border-inline-start: 3px solid var(--landing-teal); background: var(--landing-wash); color: var(--landing-blue); font-size: 1.4rem; line-height: 1.1; }
  .total-count span { margin-block-start: .25rem; color: var(--landing-muted); font-size: .72rem; font-weight: 500; }
  .department-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .85rem; }
  .department-card { display: flex; min-height: 190px; flex-direction: column; padding: 1.1rem; border: 1px solid var(--landing-line); background: var(--landing-surface); color: inherit; text-decoration: none; transition: border-color .18s ease, box-shadow .18s ease; }
  .department-card:hover { border-color: var(--landing-ink); box-shadow: 0 8px 22px rgba(0, 0, 0, .08); text-decoration: none; }
  .card-count { color: var(--landing-teal); font-size: .72rem; font-weight: 750; }
  .department-card h3 { margin: .65rem 0 .35rem; color: var(--landing-ink); font-size: 1.15rem; }
  .department-card p { margin: 0 0 1rem; color: var(--landing-muted); font-size: .86rem; line-height: 1.55; }
  .card-link { display: flex; justify-content: space-between; gap: .6rem; margin-block-start: auto; padding-block-start: .7rem; border-block-start: 1px solid var(--landing-line); color: var(--landing-blue); font-size: .8rem; font-weight: 750; }
  .case-list { display: grid; gap: .7rem; }
  .case-row { display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; padding: 1rem 1.1rem; border: 1px solid var(--landing-line); background: var(--landing-surface); }
  .case-copy { min-width: 0; }
  .department-tag { display: inline-flex; padding: .2rem .5rem; background: var(--landing-wash); color: var(--landing-ink); font-size: .68rem; font-weight: 750; }
  .case-row h3 { margin: .5rem 0 .25rem; color: var(--landing-ink); font-size: 1rem; }
  .case-row h3 a { color: inherit; text-decoration: none; }
  .case-row h3 a:hover { color: var(--landing-blue); text-decoration: underline; text-underline-offset: .18em; }
  .case-row p { margin: 0; color: var(--landing-muted); font-size: .84rem; line-height: 1.5; }
  .case-meta { display: flex; flex-wrap: wrap; gap: .75rem; margin-block-start: .55rem; color: var(--landing-muted); font-size: .7rem; }
  .case-meta span + span::before { content: '/'; margin-inline-end: .75rem; color: var(--landing-muted); }
  .open-link { display: inline-flex; flex: none; align-items: center; gap: .45rem; color: var(--landing-blue); font-size: .78rem; font-weight: 750; text-decoration: none; }
  .open-link:hover { text-decoration: underline; text-underline-offset: .18em; }
  .empty-state { padding: 2rem; border: 1px dashed var(--landing-line); color: var(--landing-muted); text-align: center; }
  .back-link { display: inline-flex; gap: .5rem; margin-block-start: 1.4rem; color: var(--landing-blue); font-size: .84rem; font-weight: 750; text-decoration: none; }
  :global([data-theme='dark']) .landing { --landing-ink: #ffffff; --landing-muted: #bbbbbb; --landing-line: #484848; --landing-surface: #111111; --landing-wash: #222222; --landing-blue: #ffffff; --landing-teal: #ffffff; }
  @media (max-width: 720px) {
    .landing-head { align-items: start; gap: .8rem; }
    .landing-head h2 { font-size: 1.5rem; }
    .department-grid { grid-template-columns: 1fr; }
    .department-card { min-height: 0; }
    .case-row { align-items: start; flex-direction: column; gap: .8rem; }
  }
</style>