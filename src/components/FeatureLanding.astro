  .prompt-section { --prompt-ink: #111; --prompt-muted: #555; --prompt-line: #d8d8d8; --prompt-surface: #fff; --prompt-wash: #f4f4f4; --prompt-action: #111; --prompt-action-ink: #fff; margin-block-start: 2rem; padding: 1.1rem; border: 1px solid var(--prompt-line); border-top: 3px solid var(--prompt-ink); background: var(--prompt-surface); color: var(--prompt-ink); }
